# syntax=docker/dockerfile:1
# Build: docker build -f Dockerfile.vps -t imotko-express .  (named .vps so Railway keeps its own builder)

# One image for both Dokploy apps:
#   API    (default CMD)  node --experimental-transform-types src/app.js
#   Worker (command override in Dokploy)  node --experimental-transform-types workers/index.js
# No HEALTHCHECK here on purpose: the worker has no HTTP server, so the /health probe is configured on the API app
# only (Dokploy -> Advanced -> Swarm settings).
FROM node:22.17.1-bookworm-slim

ENV NODE_ENV=production \
    PORT=5050

# openssl + CA certificates for Prisma/pg TLS to Supabase and rediss:// to Upstash
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Same pnpm as package.json "packageManager"
RUN npm install -g pnpm@10.30.3

WORKDIR /app

# Dependencies first so code-only changes reuse this layer
COPY package.json pnpm-lock.yaml prisma.config.js ./
COPY prisma ./prisma

# postinstall runs `prisma generate`; prisma.config.js requires DIRECT_URL to be set but generate never connects,
# so a placeholder keeps real credentials out of the image.
RUN DIRECT_URL="postgresql://build:build@localhost:5432/build" pnpm install --frozen-lockfile --prod

COPY src ./src
COPY workers ./workers
COPY scripts ./scripts

# App files stay root-owned (read-only for the process); only the errorMiddleware file log is writable
RUN mkdir -p src/api/v1/logs && chown -R node:node src/api/v1/logs

USER node

EXPOSE 5050

# node runs as PID 1 directly (not via pnpm) so SIGTERM reaches the graceful shutdown handlers
CMD ["node", "--experimental-transform-types", "src/app.js"]
