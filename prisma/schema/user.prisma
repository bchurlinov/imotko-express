enum UserRole {
  CLIENT
  AGENCY
  ADMIN
}

enum UserLanguage {
  EN
  MK
  AL
  SQ
  TR
}

enum PushPlatform {
  ios
  android
}

enum PushLocale {
  mk
  en
  sq
  tr
}

enum NotificationStatus {
  READ
  UNREAD
}

model Admin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                @id @default(cuid())
  supabaseUserId          String?               @unique
  name                    String
  lastName                String?
  email                   String                @unique
  location                String?
  emailVerified           DateTime?
  image                   String?
  hashedPassword          String?
  phone                   String?
  accessToken             String?
  refreshToken            String?
  language                UserLanguage?         @default(MK)
  role                    UserRole              @default(CLIENT)
  account                 Account?
  clientId                String?
  client                  Client?
  notifications           Notification[]
  pushTokens              UserPushToken[]
  agencyId                String?
  agency                  Agency?               @relation(fields: [agencyId], references: [id])
  adminId                 String?
  admin                   Admin?
  ipAddress               String?
  leadPopupShownAt        DateTime?             @db.Timestamptz(3)
  externalAdsPopupShownAt DateTime?             @db.Timestamptz(3)
  UserFeatureRequest      UserFeatureRequest[]
  //
  agencyMember            AgencyMember?         @relation("AgencyMember")
  ownedAgency             Agency?               @relation("AgencyOwner")
  //
  agencyInvitationSender  AgencyInvitation[]    @relation("InvitingSender")
  leadMatchSendsSent      LeadClientMatchSend[]
  messagingFlagged         Boolean                   @default(false)
  messagingFlaggedAt       DateTime?                 @db.Timestamptz(3)
  messagingFlagReason      MessagingFlagReason?
  messagingFlaggedById     String?
  messagingUnflaggedAt     DateTime?                 @db.Timestamptz(3)
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  createdAt               DateTime?             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime?             @updatedAt @db.Timestamptz(3)

  @@index([agencyId])
  @@index([clientId])
}

model UserPushToken {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String           @unique
  platform    PushPlatform
  locale      PushLocale
  // App version that registered token from X-Imotko-App-Version. Null means app before 1.1.0.
  appVersion  String?
  lastSeenAt  DateTime         @default(now()) @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  pushTickets ExpoPushTicket[]

  @@index([userId])
}

model ExpoPushTicket {
  id             String        @id @default(cuid())
  tokenId        String
  token          UserPushToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  messageId      String
  conversationId String
  ticketId       String        @unique
  receiptCheckedAt DateTime?   @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([receiptCheckedAt, createdAt])
  @@index([messageId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @unique
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Notification {
  id          String             @id @default(cuid())
  title       String
  description String
  status      NotificationStatus @default(UNREAD)
  recipientId String
  recipient   User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  readAt      DateTime?
  metadata    Json?
}

model UserFeatureRequest {
  id          String    @id @default(cuid())
  featureName String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime? @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String   @unique
  userId  String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}
