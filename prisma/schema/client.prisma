model Client {
  id                         String                       @id @default(cuid())
  clientSubscription         ClientPropertySubscription[]
  favorites                  PropertyFavorite[]
  propertyViews              PropertyView[]
  clientSearches             ClientSearch[]
  reviews                    AgencyReview[]
  receiveCompanyEmail        Boolean                      @default(true)
  receiveCompanySMS          Boolean?                     @default(false)
  receiveAgentEmail          Boolean?                     @default(false)
  receiveAgentSMS            Boolean?                     @default(false)
  chatEmailsEnabled          Boolean                      @default(true)
  chatEmailsUnsubscribeToken String                       @unique @default(dbgenerated("(gen_random_uuid())::text"))
  userId                     String                       @unique
  user                       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt @db.Timestamptz(3)
  AgencyView                 AgencyView[]
  PropertyEngagement         PropertyEngagement[]
  Proposal                   Proposal[]
  ProposalCollaboration      ProposalCollaboration[]
  preferences                Json?
  leadMatchSends             LeadClientMatchSend[]
  credits                    Int                          @default(150)
  properties                 Property[]                   @relation("ClientListings")
  propertyOutreaches         PropertyOutreach[]

  @@index([userId])
}

model ClientSearch {
  id                         String                      @id @default(cuid())
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  clientId                   String
  client                     Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                      Json
  link                       String
  filters                    Json
  clientPropertySubscription ClientPropertySubscription?
  receiveOffers              Boolean                     @default(false)
  agencyIdsJson              Json?
  unsubscribeToken           String?                     @unique
  unsubscribedAt             DateTime?                   @db.Timestamptz(3)

  // PERF(DB-03): FK had no index (Supabase lint 0001). A client's saved searches are always read by clientId (account
  // page, mobile, menu summary), and deleting a client cascades here.
  @@index([clientId])
}

model ClientPropertySubscription {
  id             String               @id @default(cuid())
  minSize        Int?
  maxSize        Int?
  minPrice       Int?
  maxPrice       Int?
  location       String?
  listingType    PropertyListingType?
  category       String
  subCategory    String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  clientId       String?
  client         Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientSearchId String?              @unique()
  clientSearch   ClientSearch?        @relation(fields: [clientSearchId], references: [id], onDelete: Cascade)

  @@index([listingType, category, location])
  // PERF(DB-03): FK had no index (Supabase lint 0001). Subscriptions are read per client and deleting a client
  // cascades here.
  @@index([clientId])
}
