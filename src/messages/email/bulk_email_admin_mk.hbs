<html>
<head>
    <title>Имотко мејл</title>
    <style>
        a, a:link {
            color: #9573c9;
        }
    </style>
</head>
<body style="background: #f9f9f9; font-family: 'Arial'">
<table style="width: 600px; margin: 0 auto; border-spacing: 0; font-family: 'Arial';" cellSpacing="0">
    <tr>
        <td align="center" style="padding: 20px; text-align: center;">
            <img style="display:block;width:112px;max-width:112px;height:auto;margin:0 auto;border:0;" src="https://imotko.mk/icons/logo_email.png" alt="Имотко" width="112"/>
        </td>
    </tr>
    <tr>
        <td style="padding: 20px; padding-bottom: 0; background: white; border-radius:4px">
            <h1 style="color: #3a3a3a; font-family: 'Arial'; font-size: 20px; line-height: 26px">{{title}}</h1>
            <p style="color: #3a3a3a; font-family: 'Arial'; font-size: 14px; line-height: 20px">
                {{{content}}}
            </p>
        </td>
    </tr>

    <tr>
        <td style="padding: 20px; background: white">
            <p style="color: #3a3a3a; font-family: 'Arial'; font-size: 14px; line-height: 20px">Со почит,<br/> <strong>
                Тимот на Имотко</strong><br/>
        </td>
    </tr>
</table>
</body>
</html>
