<html lang="{{locale}}">
    <body style="font-family:Arial,sans-serif;color:#111827;line-height:1.5">
        <p><img src="https://imotko.mk/icons/logo_email.png" width="164" alt="Имотко" style="display:block;border:0"></p>
        <h1>{{headline}}</h1>
        <p>{{intro}}</p>
        {{#if propertyTitle}}<p><strong>{{propertyLabel}}:</strong> {{propertyTitle}}</p>{{/if}}
        <p>{{instructions}}</p>
        <p><a href="{{link}}">{{openLabel}}</a></p>
        {{#if unsubscribeLink}}<p style="color:#6b7280;font-size:13px">{{unsubscribeText}} <a href="{{unsubscribeLink}}">{{unsubscribeLabel}}</a></p>{{/if}}
    </body>
</html>